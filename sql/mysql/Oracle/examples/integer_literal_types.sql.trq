(: Token type of each integer literal in integer_literal_types.sql, in order of appearance, as the server's
   int_token() (sql_lex.cc) assigns it. LONG_NUMBER and ULONGLONG_NUMBER are interchangeable in every parser
   rule, so only this check sees the boundary between them. :)
let $expected := (
    "0 INT_NUMBER", "123 INT_NUMBER", "999999999 INT_NUMBER", "2147483647 INT_NUMBER",
    "00000000002147483647 INT_NUMBER", "000000000000 INT_NUMBER",
    "2147483648 LONG_NUMBER", "4294967295 LONG_NUMBER", "9999999999 LONG_NUMBER", "10000000000 LONG_NUMBER",
    "21474836470 LONG_NUMBER", "30000000000 LONG_NUMBER", "99999999999 LONG_NUMBER",
    "9223372036854775807 LONG_NUMBER", "00000000002147483648 LONG_NUMBER",
    "9223372036854775808 ULONGLONG_NUMBER", "9999999999999999999 ULONGLONG_NUMBER",
    "10000000000000000000 ULONGLONG_NUMBER", "18446744073709551615 ULONGLONG_NUMBER",
    "0009223372036854775808 ULONGLONG_NUMBER",
    "18446744073709551616 DECIMAL_NUMBER", "99999999999999999999 DECIMAL_NUMBER",
    "100000000000000000000 DECIMAL_NUMBER", "92233720368547758070 DECIMAL_NUMBER",
    "184467440737095516150 DECIMAL_NUMBER",
    "2147483647 INT_NUMBER", "00000000002147483647 INT_NUMBER", "000000000000 INT_NUMBER"
)
let $actual :=
    for $t in //(INT_NUMBER | LONG_NUMBER | ULONGLONG_NUMBER | DECIMAL_NUMBER)
    return concat($t/text(), " ", local-name($t))
return
    if (deep-equal($actual, $expected))
    then ""
    else concat("Integer literals typed differently from int_token(): ", string-join($actual, ", "))
