% while and for, each still closed with "end loop".

module Loops =
begin
    var i : integer;
    var total : integer;

    i := 0;
    total := 0;
    while i < 10 do
        total := total + i;
        i := i + 1;
    end loop

    for i : 1 to 5 do
        total := total + i;
    end loop
end Loops
