!! declare entities, attributes, processes, and event notices in the PREAMBLE
PREAMBLE
    EVERY CUSTOMER HAS AN ARRIVAL_TIME, A SERVICE_TIME.
    EVERY SERVER HAS A BUSY_FLAG.
    PROCESSES INCLUDE CUSTOMER, SERVER.
    EVENT NOTICES INCLUDE ARRIVAL, DEPARTURE.
    DEFINE QUEUE_LENGTH AS INTEGER VARIABLE.
    DEFINE AVERAGE_WAIT AS REAL VARIABLE.
END

MAIN
    LET QUEUE_LENGTH = 0
    PRINT QUEUE_LENGTH
END
