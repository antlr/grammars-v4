/* DECIDE ON FIRST VALUE OF, with a NONE VALUE default, ends with
/* END-DECIDE.
DEFINE DATA LOCAL
1 #N (I4)
1 #LABEL (A10)
END-DEFINE

MOVE 2 TO #N
DECIDE ON FIRST VALUE OF #N
  VALUE 1
    MOVE 'ONE' TO #LABEL
  VALUE 2, 3
    MOVE 'TWO-THREE' TO #LABEL
  NONE VALUE
    MOVE 'OTHER' TO #LABEL
END-DECIDE
WRITE #LABEL
END
