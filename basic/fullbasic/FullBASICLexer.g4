NEXT: 'NEXT';
NOT: 'NOT';
NUMERIC: 'NUMERIC';
OFF: 'OFF';
ON: 'ON';
OPEN: 'OPEN';
OR: 'OR';
ORGANIZATION: 'ORGANIZATION';
