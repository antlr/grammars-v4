/*
 * Full BASIC
 *   ANSI X3.113-1987 (as adopted in FIPS PUB 68-2)
 *   ECMA-116, 1st edition, June 1986
 *   ISO/IEC 10279:1991
 * Section numbers (§) refer to ANSI X3.113-1987.
 * Modules: Core, Enhanced files, Exception handling, Graphics, Fixed decimal.
 *
 * Copyright (c) 2026 AJGB (ajgb.eu)
 * SPDX-License-Identifier: MIT
 */




lexer grammar FullBASICLexer;

// §4.1.4
options {
    caseInsensitive = true;
}

// §4.3, §5.4
REMARK_STRING: REM NON_WORD_REM NON_EOL_CHAR*;
fragment NON_WORD_REM: ~[A-Z0-9_\r\n];
fragment NON_EOL_CHAR: ~[\r\n];

TAIL_COMMENT: EXCLAMATION_MARK ~ [\r\n]*;

OPTION: 'OPTION';
BASE: 'BASE';

DECIMAL: 'DECIMAL';
NATIVE: 'NATIVE';
FIXED: 'FIXED';

ANGLE: 'ANGLE';
DEGREES: 'DEGREES';
RADIANS: 'RADIANS';

COLLATE: 'COLLATE';
STANDARD: 'STANDARD';

QUOTATION_MARK: '"';

AMPERSAND: '&';
ASTERISK: '*';
CIRCUMFLEX_ACCENT: '^';
COLON: ':';
COMMA: ',';
EQUALS_SIGN: '=';
EXCLAMATION_MARK: '!';
GREATER_THAN_SIGN: '>';
LEFT_PARENTHESIS: '(';
LESS_THAN_SIGN: '<';
MINUS_SIGN: '-';
NUMBER_SIGN: '#';
PERIOD: '.';
PLUS_SIGN: '+';
QUESTION_MARK: '?';
RIGHT_PARENTHESIS: ')';
SEMICOLON: ';';
SLANT: '/';
END_LINE: '\r'? '\n';

fragment DIGIT: [0-9];
fragment DIGITS: DIGIT+;
fragment EXP_PART: [E] [+-]? DIGITS;

UNSIGNED_INT: DIGITS;

UNSIGNED_FIXED: DIGITS '.' DIGITS* | '.' DIGITS;

UNSIGNED_SCI:
    DIGITS EXP_PART
    | DIGITS '.' DIGITS* EXP_PART
    | '.' DIGITS EXP_PART
;

NOT_LESS:
    GREATER_THAN_SIGN EQUALS_SIGN
    | EQUALS_SIGN GREATER_THAN_SIGN
;
NOT_GREATER:
    LESS_THAN_SIGN EQUALS_SIGN
    | EQUALS_SIGN LESS_THAN_SIGN
;
NOT_EQUALS:
    LESS_THAN_SIGN GREATER_THAN_SIGN
    | GREATER_THAN_SIGN LESS_THAN_SIGN
;

ABS: 'ABS';
ACOS: 'ACOS';
ASIN: 'ASIN';
ATN: 'ATN';
CEIL: 'CEIL';
COS: 'COS';
COSH: 'COSH';
COT: 'COT';
CSC: 'CSC';
DATE: 'DATE';
DEG: 'DEG';
EPS: 'EPS';
EXP: 'EXP';
FP: 'FP';
MAXNUM: 'MAXNUM';
INT: 'INT';
IP: 'IP';
LOG: 'LOG';
LOG10: 'LOG10';
LOG2: 'LOG2';
MAX: 'MAX';
MIN: 'MIN';
MOD: 'MOD';
PI: 'PI';
RAD: 'RAD';
REMAINDER: 'REMAINDER';
RND: 'RND';
ROUND: 'ROUND';
SEC: 'SEC';
SGN: 'SGN';
SIN: 'SIN';
SINH: 'SINH';
SQR: 'SQR';
TAN: 'TAN';
TANH: 'TANH';
TIME: 'TIME';
TRUNCATE: 'TRUNCATE';

CHR_: 'CHR$';
DATE_: 'DATE$';
LCASE_: 'LCASE$';
LTRIM_: 'LTRIM$';
REPEAT_: 'REPEAT$';
RTRIM_: 'RTRIM$';
STR_: 'STR$';
TIME_: 'TIME$';
UCASE_: 'UCASE$';
USING_: 'USING$';

ACCESS: 'ACCESS';
