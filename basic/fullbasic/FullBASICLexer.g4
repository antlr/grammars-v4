LIMIT: 'LIMIT';
DRAW: 'DRAW';
ROTATE: 'ROTATE';
SHEAR: 'SHEAR';
SHIFT: 'SHIFT';
SCALE: 'SCALE';
PICTURE: 'PICTURE';
