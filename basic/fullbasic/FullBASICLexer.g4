GRAPH: 'GRAPH';
IF: 'IF';
IMAGE: 'IMAGE';
INPUT: 'INPUT';
INTERNAL: 'INTERNAL';
IS: 'IS';
LENGTH: 'LENGTH';
LET: 'LET';
LINE: 'LINE';
LINES: 'LINES';
LOOP: 'LOOP';
