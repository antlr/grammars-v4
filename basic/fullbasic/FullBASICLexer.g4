CELLS: 'CELLS';
GET: 'GET';
LOCATE: 'LOCATE';
CHOICE: 'CHOICE';
VALUE: 'VALUE';
RANGE: 'RANGE';
PIXEL: 'PIXEL';
ARRAY: 'ARRAY';
MULTIPOINT: 'MULTIPOINT';

// §4.4.4, §6.1.4
NUMERIC_IDENTIFIER: [A-Z][A-Z0-9_]*;
STRING_IDENTIFIER: [A-Z][A-Z0-9_]* [$];
STRINGLITERAL:
    QUOTATION_MARK (~["\r\n] | QUOTATION_MARK QUOTATION_MARK)* QUOTATION_MARK
;

OTHER_CHARACTER: [\u0080-\u00FF]+;
WS: [ \t]+ -> channel(HIDDEN);
CONT: AMPERSAND WS* END_LINE WS* AMPERSAND -> skip;
// §4.2.2
COMMENT_CONT:
    EXCLAMATION_MARK ~[\r\n]* AMPERSAND WS* END_LINE WS* AMPERSAND -> skip
;
// §4.2.2, §4.2.3
CONT_COMMENT:
    AMPERSAND WS* EXCLAMATION_MARK ~[\r\n]* END_LINE WS* AMPERSAND -> skip
;

// §10.4.2
IMAGE_COLON: 'IMAGE' [ \t]* ':' -> pushMode(IMAGE_MODE);
mode IMAGE_MODE;
IMAGE_BODY: ~[\r\n]+;
IMAGE_MODE_TAIL: END_LINE -> popMode;