REST: 'REST';
RESTORE: 'RESTORE';
RETURN: 'RETURN';
SAME: 'SAME';
SELECT: 'SELECT';
SEQUENTIAL: 'SEQUENTIAL';
SET: 'SET';
SETTER: 'SETTER';
SIZE: 'SIZE';
SKIP_: 'SKIP';
STATUS: 'STATUS';
STEP: 'STEP';
STOP: 'STOP';
STREAM: 'STREAM';
STRING: 'STRING';
STYLE: 'STYLE';
SUB: 'SUB';
TAB: 'TAB';
TEXT: 'TEXT';
HEIGHT: 'HEIGHT';
JUSTIFY: 'JUSTIFY';
THEN: 'THEN';
THERE: 'THERE';
TIMEOUT: 'TIMEOUT';
TO: 'TO';
TRACE: 'TRACE';
UNTIL: 'UNTIL';
USING: 'USING';
VARIABLE: 'VARIABLE';
VIEWPORT: 'VIEWPORT';
WHILE: 'WHILE';
WINDOW: 'WINDOW';
WITH: 'WITH';
WRITE: 'WRITE';
ZONEWIDTH: 'ZONEWIDTH';

EXLINE: 'EXLINE';
EXTYPE: 'EXTYPE';
EXTEXT_: 'EXTEXT$';

CON: 'CON';
IDN: 'IDN';
ZER: 'ZER';
NUL: 'NUL$';

TRANSFORM: 'TRANSFORM';

LEN: 'LEN';
ORD: 'ORD';
POS: 'POS';
VAL: 'VAL';
MAXLEN: 'MAXLEN';
LCASE: 'LCASE';
LTRIM: 'LTRIM';
REPEAT: 'REPEAT';
RTRIM: 'RTRIM';
