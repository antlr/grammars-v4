1 REM FBCS ECMA-0096
2 REM CLAIM A-ECMA-37
3 REM TYPE SELF
100 SET WINDOW 0, 10, -5, 5
110 SET VIEWPORT .2, .8, .1, .4
120 ASK WINDOW X1, X2, Y1, Y2
130 ASK VIEWPORT L, R, B, T
140 ASK DEVICE WINDOW XMIN, XMAX, YMIN, YMAX
150 ASK DEVICE VIEWPORT LEFT, RIGHT, BOTTOM, TOP
160 ASK DEVICE SIZE Width, Height, Unit$
170 ASK CLIP CLIP_STATE$
180 IF X1=0 AND X2=10 AND Y1=-5 AND Y2=5 AND L=.2 AND R=.8 AND B=.1 AND T=.4 AND CLIP_STATE$="ON" THEN PRINT &
&"*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
190 END
