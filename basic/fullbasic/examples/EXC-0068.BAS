1 REM FBCS EXC-0068
2 REM CLAIM A-12.1.4-18
3 REM TYPE SELF
100 REM STD 11.3.4 l.7517-7531 + 11.3.4.1 l.7546-7560: an exception before
110 REM the PRINT # completes adds no record (not even a partial one) to the
120 REM file, even with earlier items in the same statement.
130 OPEN #1: NAME "exc0068.dat", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
140 WHEN EXCEPTION IN
150   PRINT #1, USING "##, ##": 12, 123
160 USE
170   PRINT "E="; EXTYPE
180 END WHEN
190 CLOSE #1
200 OPEN #2: NAME "exc0068.dat", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
210 LINE INPUT #2, IF MISSING THEN 240: A$
220 PRINT "*** TEST FAILED ***"
230 GOTO 250
240 PRINT "*** TEST PASSED ***"
250 END
