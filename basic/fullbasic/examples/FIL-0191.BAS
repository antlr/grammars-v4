140 CLOSE #1
150 OPEN #1: NAME "FIL0191.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 LET N = 0
170 LINE INPUT #1, IF MISSING THEN 200: R$
180 LET N = N + 1
190 GOTO 170
200 CLOSE #1
210 IF N = 3 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: RECORDS"; N
220 GOTO 420
400 IMAGE: ###
410 IMAGE: ### ###
420 END
