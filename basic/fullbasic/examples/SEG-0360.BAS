1 REM FBCS SEG-0360
2 REM CLAIM A-6.5.5-EXC
3 REM TYPE SELF
100 REM A LET INTO A SUBSTRING THAT OVERFLOWS STILL RAISES 1106 (6.5.5 l.2820)
110 DECLARE STRING A$ * 3
120 DECLARE STRING B$(2) * 3
130 LET A$ = "ABC"
140 LET B$(1) = "ABC"
150 LET OK = 0
160 WHEN EXCEPTION IN
170   LET A$(2:1) = "X"
180 USE
190   IF EXTYPE = 1106 AND A$ = "ABC" THEN LET OK = OK + 1
200 END WHEN
210 WHEN EXCEPTION IN
220   LET B$(1)(2:1) = "X"
230 USE
240   IF EXTYPE = 1106 AND B$(1) = "ABC" THEN LET OK = OK + 1
250 END WHEN
260 IF OK = 2 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
270 END
