1 REM FBCS ENH-0006
2 REM CLAIM A-ENH-6
3 REM TYPE SELF
100 OPEN #1: NAME "ENH0006.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
110 WRITE #1, RECORD 1: "UNO"
120 WRITE #1, RECORD 2: "DOS"
130 WRITE #1, RECORD 3: "TRES"
140 SET #1: RECORD 1
150 NEXT #1
160 READ #1: A$
170 NEXT #1, RECORD 3
180 READ #1: B$
190 CLOSE #1
200 IF A$ = "UNO" AND B$ = "TRES" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
210 END
