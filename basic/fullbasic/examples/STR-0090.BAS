1 REM FBCS STR-0090
2 REM CLAIM A-6.4.4-07
3 REM TYPE SELF
100 REM STR$ of a non-integer that rounds to d = 8 digits with no fraction keeps the period, as PRINT does
110 REM Standard 6.4.4 l.2702-2705 with 10.3.4.1 l.5375-5377, l.5388-5389
120 OPTION ARITHMETIC DECIMAL
130 LET FAIL = 0
140 LET A = 2.9999999999
150 LET B = -12345678.9
160 IF STR$(A) <> "3." THEN LET FAIL = FAIL + 1
170 IF STR$(B) <> "-12345679." THEN LET FAIL = FAIL + 1
180 IF STR$(3) <> "3" THEN LET FAIL = FAIL + 1
190 IF STR$(99999999.6) <> "1.E+8" THEN LET FAIL = FAIL + 1
200 IF FAIL = 0 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
210 END
