1 REM FBCS GFX-0039
2 REM CLAIM A-13.2.4-11
3 REM TYPE SELF
100 PRINT "GFX-0039 ASK COLOR MIX STATUS 11086 OUT OF RANGE, 11087 UNSET (13.2.4)"
110 LET OK = 1
120 ASK COLOR MIX(9999) R, G, B STATUS S1
130 IF S1 <> 11086 OR R <> 0 OR G <> 0 OR B <> 0 THEN LET OK = 0
140 ASK COLOR MIX(5) R, G, B STATUS S2
150 IF S2 <> 11087 OR R <> 0 OR G <> 0 OR B <> 0 THEN LET OK = 0
160 SET COLOR MIX(3) 0.4, 0.5, 0.6
170 ASK COLOR MIX(3) R, G, B STATUS S3
180 IF S3 <> 0 OR ABS(R - .4) > 1E-9 OR ABS(G - .5) > 1E-9 OR ABS(B - .6) > 1E-9 THEN LET OK = 0
190 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
