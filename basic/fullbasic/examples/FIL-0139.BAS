1 REM FBCS FIL-0139
2 REM CLAIM A-11.4.4.5-01
3 REM TYPE SELF
100 PRINT "FIL-0139 MAT LINE INPUT REDIM BELOW ONE KEEPS OLD VALUES AND RAISES (11.4.4.5)"
110 OPEN #1: NAME "FIL0139.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "L1"
130 PRINT #1: "L2"
140 CLOSE #1
150 OPEN #2: NAME "FIL0139.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
160 DIM A$(3)
170 LET A$(1) = "OLD1"
180 LET OK = 0
190 WHEN EXCEPTION IN
200   MAT LINE INPUT #2: A$(0)
210   PRINT "*** TEST FAILED: NO EXCEPTION ***"
220 USE
230   IF EXTYPE = 6005 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
240 END WHEN
250 CLOSE #2
260 IF OK = 1 AND A$(1) = "OLD1" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; OK; " <"; A$(1); ">"
270 END
