1 REM FBCS ENH-0007
2 REM CLAIM A-ENH-7
3 REM TYPE SELF
100 OPEN #1: NAME "ENH0007.DAT", ACCESS OUTIN, ORGANIZATION RELATIVE, RECTYPE DISPLAY
110 WRITE #1, RECORD 1: "UNO"
120 WRITE #1, RECORD 2: "DOS"
130 WRITE #1, RECORD 3: "TRES"
140 RANDOM #1 RECORD 2
150 READ #1: A$
160 RANDOM #1 RECORD 3
170 READ #1: B$
180 CLOSE #1
190 IF A$ = "DOS" AND B$ = "TRES" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; A$; "/"; B$
200 END
