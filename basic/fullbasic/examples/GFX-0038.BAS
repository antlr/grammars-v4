1 REM FBCS GFX-0038
2 REM CLAIM A-13.2.4-10
3 REM TYPE SELF
100 PRINT "GFX-0038 SET COLOR MIX ROUNDS INDEX, RGB IN [0,1], 0 IS BACKGROUND (13.2.4)"
110 LET OK = 1
120 SET COLOR MIX(2) 0.1, 0.2, 0.3
130 ASK COLOR MIX(2) R, G, B
140 IF ABS(R - .1) > 1E-9 OR ABS(G - .2) > 1E-9 OR ABS(B - .3) > 1E-9 THEN LET OK = 0
150 SET COLOR MIX(1.6) 0.7, 0.8, 0.9
160 ASK COLOR MIX(2) R, G, B
170 IF ABS(R - .7) > 1E-9 OR ABS(G - .8) > 1E-9 OR ABS(B - .9) > 1E-9 THEN LET OK = 0
180 SET COLOR MIX(0) 0, 0, 0
190 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
200 END
