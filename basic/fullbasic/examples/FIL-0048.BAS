1 REM FBCS FIL-0048
2 REM CLAIM A-11.1.4.2-03
3 REM TYPE SELF
100 PRINT "FIL-0048 ERASE IS ALLOWED ONLY ON A FILE OPENED AS OUTIN (11.1.4.2)"
110 OPEN #1: NAME "FIL0048.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
120 PRINT #1: "X"
130 CLOSE #1
140 OPEN #2: NAME "FIL0048.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
150 LET OK = 0
160 WHEN EXCEPTION IN
170   ERASE #2
180   PRINT "*** TEST FAILED: NO EXCEPTION ***"
190 USE
200   IF EXTYPE = 7301 THEN LET OK = 1 ELSE PRINT "*** TEST FAILED: EXTYPE"; EXTYPE
210 END WHEN
220 CLOSE #2
230 OPEN #3: NAME "FIL0048.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
240 ERASE #3
250 CLOSE #3
260 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
270 END
