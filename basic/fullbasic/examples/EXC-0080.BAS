1 REM FBCS EXC-0080
2 REM CLAIM A-12.1.4-13
3 REM TYPE SELF
10 REM Negative codes, STD 12.1.4 l.8913-8917: at two levels,
20 REM EXTYPE = -100000 + (-5) = -100005, no -200005.
30 DECLARE EXTERNAL SUB S
40 WHEN EXCEPTION IN
50   CALL S
60 USE
70   IF EXTYPE = -100005 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE
80 END WHEN
90 END
100 EXTERNAL SUB S
110 DECLARE EXTERNAL SUB T
120 CALL T
130 END SUB
150 EXTERNAL SUB T
160 CAUSE EXCEPTION -5
170 END SUB
