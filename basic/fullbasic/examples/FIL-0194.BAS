1 REM FBCS FIL-0194
2 REM CLAIM A-11.2.4.1-03
3 REM TYPE SELF
4 REM SET POINTER NEXT on a KEYED file leaves the pointer unchanged (it always
5 REM points at an existing element or end of file): READ then visits every key
6 REM in collating order.
100 PRINT "FIL-0194 SET POINTER NEXT ON A KEYED FILE VISITS EVERY KEY IN ORDER"
110 OPEN #1: NAME "FIL0194.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 WRITE #1, KEY "A": "ONE"
130 WRITE #1, KEY "B": "TWO"
140 WRITE #1, KEY "C": "THREE"
150 SET #1: KEY >= "A"
160 LET R$ = ""
170 FOR I = 1 TO 3
180 SET #1: POINTER NEXT
190 READ #1: S$
200 LET R$ = R$ & S$ & ","
210 NEXT I
220 CLOSE #1
230 IF R$ = "ONE,TWO,THREE," THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: "; R$
240 END
