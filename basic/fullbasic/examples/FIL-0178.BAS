1 REM FBCS FIL-0178
2 REM CLAIM A-11.2.4.1-G02
3 REM TYPE SELF
100 PRINT "FIL-0178 SET # KEY INEXACT AND MISS SETS POINTER PER 11.2.4.1 (11.2.4.1)"
110 OPEN #1: NAME "FIL0178.DAT", ACCESS OUTIN, ORGANIZATION KEYED, RECTYPE DISPLAY
120 WRITE #1, KEY "A": "FIRST"
130 WRITE #1, KEY "C": "THIRD"
140 CLOSE #1
160 OPEN #2: NAME "FIL0178.DAT", ACCESS INPUT, ORGANIZATION KEYED, RECTYPE DISPLAY
170 LET OK = 1
180 SET #2: KEY > "A"
190 READ #2: X$
200 IF X$ <> "THIRD" THEN LET OK = 0
210 SET #2: KEY "Z"
220 LET MISSING = 0
230 READ #2, IF MISSING THEN 240: Y$
235 GOTO 250
240 LET MISSING = 1
250 CLOSE #2
260 IF OK = 1 AND MISSING = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
999 END
