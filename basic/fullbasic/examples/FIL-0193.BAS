1 REM FBCS FIL-0193
2 REM CLAIM A-11.4.4-01
3 REM TYPE SELF
4 REM READ # into a string variable inside an external subprogram reads into
5 REM the string location: no exception for a string target.
100 DECLARE EXTERNAL SUB RD
110 PRINT "FIL-0193 READ # INTO A STRING VARIABLE INSIDE AN EXTERNAL SUB"
120 OPEN #1: NAME "FIL0193.DAT", ACCESS OUTIN, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
130 WRITE #1: "ALPHA"
140 CLOSE #1
150 LET OK = 0
160 CALL RD(OK)
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED: OK="; OK
180 END
200 EXTERNAL SUB RD(OK)
210 LET S$ = ""
220 OPEN #1: NAME "FIL0193.DAT", ACCESS INPUT, ORGANIZATION SEQUENTIAL, RECTYPE DISPLAY
230 READ #1: S$
240 IF S$ = "ALPHA" THEN LET OK = 1
250 CLOSE #1
260 END SUB
