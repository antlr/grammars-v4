1 REM FBCS SEG-0218
2 REM CLAIM A-9.1.3-01
3 REM TYPE SELF
100 DECLARE FUNCTION AVERAGE, REVERSE$
110 IF AVERAGE(2,4) = 3 AND REVERSE$("abc") = "cba" THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
120 FUNCTION AVERAGE(X,Y)
130 LET AVERAGE = (X+Y)/2
140 END FUNCTION
150 FUNCTION REVERSE$(S$)
160 LET T$ = ""
170 FOR I = LEN(S$) TO 1 STEP -1
180   LET T$ = T$ & S$(I:I)
190 NEXT I
200 LET REVERSE$ = T$
210 END FUNCTION
220 END
