1 REM FBCS EXC-0211
2 REM CLAIM A-12.1.4-TR131
3 REM TYPE OUTPUT
4 REM STD 12.1.4 l.8809-8815: after calling a routine that handles its own exception, EXTYPE and EXLINE in
5 REM the calling handler are still those of the exception that made it run.
10 DECLARE EXTERNAL SUB E
20 WHEN EXCEPTION IN
30   CAUSE EXCEPTION 1
40 USE
50   CALL E
60   PRINT "MAIN"; EXTYPE; EXLINE
70 END WHEN
80 END
100 EXTERNAL SUB E
110 WHEN EXCEPTION IN
120   CAUSE EXCEPTION 2
130 USE
140   PRINT "SUB"; EXTYPE; EXLINE
150 END WHEN
160 END SUB
