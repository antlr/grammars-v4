1 REM FBCS EXC-0079
2 REM CLAIM A-12.1.4-11
3 REM TYPE SELF
10 REM STD 12.1.4 l.8900-8904: with two levels of propagation
20 REM EXTYPE = 100000 + the value in the procedure-part where the exception
30 REM ORIGINALLY occurred (100033), not 200033. EXLINE = 30.
40 DECLARE EXTERNAL SUB S
50 WHEN EXCEPTION IN
60   CALL S
70 USE
80   IF EXTYPE = 100033 AND EXLINE = 60 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"; EXTYPE; EXLINE
90 END WHEN
100 END
110 EXTERNAL SUB S
120 DECLARE EXTERNAL SUB T
130 CALL T
140 END SUB
150 EXTERNAL SUB T
160 CAUSE EXCEPTION 33
170 END SUB
