1 REM FBCS PRG-0016
2 REM CLAIM A-4.1.2-03
3 REM TYPE SELF
100 DATA ab , "c d"
110 READ X$, Y$
120 LET A$ = "a  b"
130 LET OK = 1
140 IF X$ <> "ab" OR Y$ <> "c d" THEN LET OK = 0
150 IF LEN(A$) <> 4 THEN LET OK = 0
160 IF LEN(USING$("AB ##",1)) <> 5 OR LEN(USING$("AB##",1)) <> 4 THEN LET OK = 0
170 IF OK = 1 THEN PRINT "*** TEST PASSED ***" ELSE PRINT "*** TEST FAILED ***"
180 END
